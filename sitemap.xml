/* Progressive enhancement: the page and direct downloads also work without JS. */
(() => {
  'use strict';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const root = document.documentElement;
  const motionAllowed = () => !reduceMotion.matches;

  // Scrolling content is visible by default if JS or observer support is absent.
  const reveals = Array.from(document.querySelectorAll('.reveal'));
  if ('IntersectionObserver' in window && motionAllowed()) {
    const revealObserver = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      }
    }, { threshold: 0.1, rootMargin: '0px 0px -28px 0px' });
    reveals.forEach(element => revealObserver.observe(element));
    root.classList.add('js-motion');
  }

  // Mobile navigation with keyboard dismissal and no fabricated routes.
  const menuButton = document.querySelector('.menu-toggle');
  const menu = document.querySelector('#mobile-menu');
  const closeMenu = (returnFocus = false) => {
    menuButton.setAttribute('aria-expanded', 'false');
    menuButton.setAttribute('aria-label', 'Открыть меню');
    menu.hidden = true;
    document.body.classList.remove('menu-open');
    if (returnFocus) menuButton.focus();
  };
  menuButton.addEventListener('click', () => {
    const opening = menuButton.getAttribute('aria-expanded') !== 'true';
    menuButton.setAttribute('aria-expanded', String(opening));
    menuButton.setAttribute('aria-label', opening ? 'Закрыть меню' : 'Открыть меню');
    menu.hidden = !opening;
    document.body.classList.toggle('menu-open', opening);
  });
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !menu.hidden) closeMenu(true);
  });
  document.addEventListener('click', event => {
    if (!menu.hidden && !event.target.closest('.site-header')) closeMenu();
  });
  window.addEventListener('resize', () => { if (window.innerWidth > 620) closeMenu(); }, { passive: true });

  // Real screenshot tabs, including the standard keyboard tab pattern.
  const tabs = Array.from(document.querySelectorAll('[data-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-panel]'));
  const showcase = document.querySelector('.showcase');
  const activateTab = (selected, focus = false) => {
    tabs.forEach(tab => {
      const active = tab === selected;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
    });
    panels.forEach(panel => { panel.hidden = panel.dataset.panel !== selected.dataset.tab; });
    if (focus) selected.focus();
  };
  const story = window.PulsarStory.create({ section: showcase, tabs, panels, activateTab, motionAllowed });
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      if (!story.seekTab(tab.dataset.tab)) activateTab(tab);
    });
    tab.addEventListener('keydown', event => {
      let next;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
      if (event.key === 'Home') next = 0;
      if (event.key === 'End') next = tabs.length - 1;
      if (next !== undefined) {
        event.preventDefault();
        if (story.seekTab(tabs[next].dataset.tab)) tabs[next].focus({ preventScroll: true });
        else activateTab(tabs[next], true);
      }
    });
  });
  document.querySelectorAll('[data-shot-focus]').forEach(button => {
    button.addEventListener('click', () => {
      const panel = button.closest('[data-panel]');
      const index = Number(button.dataset.shotFocus);
      if (!story.seekPair(panel, index)) window.PulsarStory.focusPair(panel, index);
    });
  });

  // Native details elements keep FAQ usable before enhancement.
  const questions = Array.from(document.querySelectorAll('.faq-list details'));
  questions.forEach(question => question.addEventListener('toggle', () => {
    if (question.open) questions.forEach(other => { if (other !== question) other.open = false; });
  }));

  // A light cursor response, limited to mouse devices and enabled motion.
  const product = document.querySelector('[data-tilt]');
  let tiltFrame = 0;
  product.addEventListener('pointermove', event => {
    if (!finePointer.matches || !motionAllowed()) return;
    const bounds = product.getBoundingClientRect();
    const x = (event.clientX - bounds.left) / bounds.width - 0.5;
    const y = (event.clientY - bounds.top) / bounds.height - 0.5;
    cancelAnimationFrame(tiltFrame);
    tiltFrame = requestAnimationFrame(() => {
      product.style.transform = `perspective(1300px) rotateY(${-7 + x * 5}deg) rotateX(${3 - y * 5}deg) rotateZ(-2deg)`;
    });
  });
  product.addEventListener('pointerleave', () => {
    cancelAnimationFrame(tiltFrame);
    product.style.removeProperty('transform');
  });

  // Progress is event driven, not another continuous animation loop.
  const progress = document.querySelector('.scroll-progress');
  const hero = document.querySelector('.hero');
  let scrollFrame = 0;
  const updateProgress = () => {
    const length = root.scrollHeight - window.innerHeight;
    progress.style.transform = `scaleX(${length > 0 ? Math.min(1, window.scrollY / length) : 0})`;
    hero.style.setProperty('--hero-shift', motionAllowed() ? Math.min(1, window.scrollY / Math.max(1, hero.offsetHeight)).toFixed(3) : '0');
    story.update();
    scrollFrame = 0;
  };
  window.addEventListener('scroll', () => {
    if (!scrollFrame) scrollFrame = requestAnimationFrame(updateProgress);
  }, { passive: true });
  window.addEventListener('resize', () => { story.refresh(); updateProgress(); }, { passive: true });
  updateProgress();

  // Delicate starfield: capped at 30 fps and stopped while the hero is offscreen.
  const canvas = document.querySelector('.starfield');
  const context = canvas.getContext('2d');
  let stars = [];
  let width = 0;
  let height = 0;
  let starFrame = 0;
  let lastTime = 0;
  let heroVisible = true;

  const drawStars = (time = 0) => {
    if (!context) return;
    context.clearRect(0, 0, width, height);
    for (const star of stars) {
      const opacity = .13 + (Math.sin(time * .0005 + star.phase) + 1) * .2;
      context.fillStyle = `rgba(153, 186, 255, ${opacity})`;
      context.beginPath();
      context.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
      context.fill();
    }
  };
  const animateStars = time => {
    if (!motionAllowed() || document.hidden || !heroVisible) { starFrame = 0; return; }
    if (time - lastTime >= 33) { drawStars(time); lastTime = time; }
    starFrame = requestAnimationFrame(animateStars);
  };
  const syncStars = () => {
    if (!context) return;
    if (motionAllowed() && !document.hidden && heroVisible) {
      if (!starFrame) starFrame = requestAnimationFrame(animateStars);
    } else {
      cancelAnimationFrame(starFrame);
      starFrame = 0;
      drawStars(0);
    }
  };
  const resizeCanvas = () => {
    if (!context) return;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    width = canvas.clientWidth;
    height = canvas.clientHeight;
    canvas.width = Math.floor(width * ratio);
    canvas.height = Math.floor(height * ratio);
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
    const count = Math.min(70, Math.floor(width * height / 15000));
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * width, y: Math.random() * height,
      radius: Math.random() * .9 + .3, phase: Math.random() * Math.PI * 2,
    }));
    drawStars();
    syncStars();
  };
  if ('ResizeObserver' in window && context) new ResizeObserver(resizeCanvas).observe(canvas);
  else window.addEventListener('resize', resizeCanvas, { passive: true });
  if ('IntersectionObserver' in window && context) {
    new IntersectionObserver(entries => { heroVisible = entries[0].isIntersecting; syncStars(); }).observe(canvas);
  }
  document.addEventListener('visibilitychange', syncStars);
  resizeCanvas();

  const syncMotion = () => {
    if (!motionAllowed()) {
      reveals.forEach(element => element.classList.add('is-visible'));
      cancelAnimationFrame(tiltFrame);
      product.style.removeProperty('transform');
    }
    story.refresh();
    updateProgress();
    syncStars();
  };
  reduceMotion.addEventListener('change', syncMotion);
  syncMotion();

  // Main buttons always hold a direct GitHub EXE URL, including offline/API failures.
  const config = JSON.parse(document.querySelector('#site-config').textContent);
  const downloadLinks = Array.from(document.querySelectorAll('[data-download]'));
  const validInstaller = value => {
    try {
      const url = new URL(value);
      return url.protocol === 'https:' && url.hostname === 'github.com'
        && !url.username && !url.password && !url.port && !url.search && !url.hash
        && url.pathname.startsWith(`/${config.github_repository}/releases/download/`)
        && /\/Pulsar_Setup_[^/]+\.exe$/i.test(url.pathname);
    } catch (_) { return false; }
  };
  const applyRelease = release => {
    if (!release || !validInstaller(release.url) || typeof release.version !== 'string'
      || !/^v?[\w.+-]{1,50}$/.test(release.version)
      || !Number.isFinite(release.size) || release.size <= 0
      || !Number.isFinite(Date.parse(release.publishedAt))) return false;
    // A cached response must never replace a more recently configured fallback.
    if (Date.parse(release.publishedAt) < Date.parse(config.published_at)) return false;
    downloadLinks.forEach(link => { link.href = release.url; });
    document.querySelectorAll('[data-version]').forEach(label => { label.textContent = `v${release.version.replace(/^v/, '')}`; });
    document.querySelectorAll('[data-size]').forEach(label => { label.textContent = `${Math.round(release.size / 1000000)} МБ`; });
    return true;
  };
  const cacheKey = `pulsar-release:${config.github_repository}`;
  const refreshRelease = async () => {
    try {
      const cached = JSON.parse(sessionStorage.getItem(cacheKey) || 'null');
      if (cached && Date.now() - cached.timestamp < 10 * 60 * 1000 && applyRelease(cached)) return;
    } catch (_) { /* Storage is optional. */ }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch(`https://api.github.com/repos/${config.github_repository}/releases/latest`, {
        headers: { Accept: 'application/vnd.github+json' }, signal: controller.signal,
        credentials: 'omit', referrerPolicy: 'no-referrer',
      });
      if (!response.ok) return;
      const data = await response.json();
      if (data.draft || data.prerelease || !Array.isArray(data.assets)) return;
      const asset = data.assets.find(item => /^Pulsar_Setup_[^/]+\.exe$/i.test(item.name) && validInstaller(item.browser_download_url));
      if (!asset) return;
      const release = {
        url: asset.browser_download_url, version: data.tag_name,
        size: asset.size, publishedAt: data.published_at, timestamp: Date.now(),
      };
      if (applyRelease(release)) {
        try { sessionStorage.setItem(cacheKey, JSON.stringify(release)); } catch (_) { /* No dependency on storage. */ }
      }
    } catch (_) { /* A direct URL to the shipped release stays available. */ }
    finally { clearTimeout(timeout); }
  };
  refreshRelease();

  const toast = document.querySelector('.toast');
  let toastTimer;
  downloadLinks.forEach(link => link.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || event.button !== 0) return;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { toast.hidden = true; }, 4500);
  }));
})();
