  .hero-product figcaption { padding-top: 12px; }
  .hero-orbit { top: 35%; right: -10%; }
  .hero::before { width: 160%; height: 90%; top: 20%; right: -45%; }
  .hero-cta { gap: 28px; }
  .button { font-size: 13px; padding: 17px 22px; min-height: 57px; }
  .hero-explore { font-size: 12px; }
