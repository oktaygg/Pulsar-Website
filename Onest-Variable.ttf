}
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .js-motion .reveal { opacity: 1 !important; transform: none !important; }
  .hero-product { transform: none !important; }
  .step-rule { width: 100%; }
  .hero-copy { transform: none !important; }
  .gallery-shot { transition: none !important; }
}
@media (max-height:720px) and (min-width:900px) {
  .is-scroll-story .caption-footnote { display: none; }
  .is-scroll-story .showcase-caption h3 { font-size: 26px; margin-top: 10px; }
  .is-scroll-story .showcase-caption p { font-size: 11px; margin-top: 12px; }
  .is-scroll-story .shot-selectors { margin-top: 14px; }
  .is-scroll-story .showcase-panel { padding-top: 16px; padding-bottom: 16px; }
}
