  .showcase-caption .eyebrow { grid-column: 1 / -1; }
  .showcase-caption h3 { font-size: 30px; margin-top: 16px; }
  .showcase-caption p { margin-top: 16px; max-width: none; }
  .showcase-gallery { height: 390px; }
  .shot-selectors { grid-column: 1 / -1; margin-top: 15px; }
  .is-scroll-story .section-heading > p { max-width: 235px; font-size: 11px; }
  .is-scroll-story .showcase-panel { grid-template-columns: 1fr; grid-template-rows: auto minmax(0,1fr); padding: 20px 24px; gap: 12px; }
  .is-scroll-story .showcase-caption { display: grid; grid-template-columns: 1fr 1fr; padding: 0; gap: 0 20px; }
  .is-scroll-story .showcase-caption .eyebrow { grid-column: 1 / -1; }
  .is-scroll-story .showcase-caption h3 { font-size: 27px; margin-top: 10px; }
  .is-scroll-story .showcase-caption p { margin-top: 10px; font-size: 11px; }
  .is-scroll-story .shot-selectors { margin-top: 12px; }
  .caption-footnote { display: none; }
  .features { padding-top: 10px; }
  .feature-row { grid-template-columns: 20px 40px 1fr; gap: 15px; padding: 25px 0; }
  .feature-row p { grid-column: 3 / 4; margin-top: -6px; max-width: 450px; }
  .getting-started .section-heading { align-items: flex-end; }
  .steps { gap: 24px; }
  .step h3 { font-size: 18px; }
  .step p { font-size: 11px; }
  .step-top > span { font-size: 46px; }
  .mobile-section { margin: 0 5%; padding: 55px 5%; grid-template-columns: 1.2fr 1fr; gap: 12px; }
