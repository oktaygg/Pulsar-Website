:root {
  color-scheme: dark;
  --bg: #080d1b;
  --surface: #0d1528;
  --brand: #172857;
  --blue: #6390ff;
  --blue-strong: #3d73f4;
  --text: #f3f5fb;
  --muted: #9ca8bf;
  --line: rgba(173, 193, 239, .13);
  --font: 'Onest', 'Segoe UI', Arial, sans-serif;
}
*, *::before, *::after { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 98px; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); -webkit-font-smoothing: antialiased; }
body.menu-open { overflow: hidden; }
button, a { -webkit-tap-highlight-color: transparent; }
button { font: inherit; color: inherit; cursor: pointer; }
a { color: inherit; text-decoration: none; }
button, input { font-family: inherit; }
img { max-width: 100%; display: block; }
button, h1, h2, h3, p, figure { margin: 0; }
button { border: 0; }
[hidden] { display: none !important; }
::selection { background: #5587f9; color: white; }
:focus-visible { outline: 2px solid #a8c2ff; outline-offset: 6px; }
.icon-library { position: absolute; width: 0; height: 0; overflow: hidden; }
.icon { width: 22px; height: 22px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.skip-link { position: fixed; z-index: 100; left: 20px; top: -100px; padding: 14px 20px; background: white; color: #080d1b; border-radius: 4px; }
.skip-link:focus { top: 12px; }
.scroll-progress { position: fixed; top: 0; left: 0; width: 100%; height: 2px; transform: scaleX(0); transform-origin: left; background: var(--blue); z-index: 60; }
.site-header { height: 88px; padding: 0 4.5%; max-width: 1728px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 36px; position: relative; z-index: 50; border-bottom: 1px solid var(--line); }
.brand { display: inline-flex; align-items: center; gap: 10px; font-size: 19px; font-weight: 850; letter-spacing: -.6px; flex-shrink: 0; }
.brand img { border-radius: 9px; }
.brand-vpn { font-size: 10px; font-weight: 500; letter-spacing: 1.4px; margin-left: 6px; color: #aebbd7; }
.desktop-nav { display: flex; gap: 31px; font-size: 12px; color: #b3bcd0; }
.desktop-nav a { position: relative; padding: 12px 0; transition: color .2s; }
.desktop-nav a::after { content: ''; position: absolute; height: 1px; width: 100%; left: 0; bottom: 4px; background: var(--blue); transform: scaleX(0); transform-origin: left; transition: transform .25s; }
.desktop-nav a:hover, .desktop-nav a.is-current { color: white; }
.desktop-nav a:hover::after, .desktop-nav a.is-current::after { transform: scaleX(1); }
.header-actions { display: flex; align-items: center; gap: 20px; }
.header-download { display: flex; align-items: center; gap: 28px; border: 1px solid #394760; padding: 11px 17px; border-radius: 4px; font-size: 12px; transition: background .2s, border-color .2s; }
.header-download .icon { width: 15px; height: 15px; }
.header-download:hover { background: #172857; border-color: #6791fc; }
.menu-toggle { display: none; width: 34px; height: 34px; background: transparent; padding: 7px 3px; }
.menu-toggle span { height: 1px; width: 24px; background: white; display: block; margin: 6px 0; transition: transform .2s; }
.menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
.menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
.mobile-menu { display: none; }
.hero { position: relative; overflow: hidden; max-width: 1728px; margin: auto; padding: 30px 4.5% 24px; isolation: isolate; }
.hero-grid { position: absolute; inset: 0; z-index: -3; background-image: linear-gradient(rgba(111, 148, 255, .025) 1px, transparent 1px), linear-gradient(90deg, rgba(111, 148, 255, .025) 1px, transparent 1px); background-size: 72px 72px; mask-image: linear-gradient(to right, transparent, #000); }
.hero::before { content: ''; position: absolute; width: 85%; height: 130%; top: -18%; right: -26%; background: radial-gradient(ellipse, rgba(34, 80, 184, .3), rgba(11, 24, 57, .2) 45%, transparent 68%); z-index: -2; }
.starfield { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; }
.hero-topline, .hero-bottom, .section-topline { display: flex; justify-content: space-between; align-items: center; gap: 20px; }
.hero-topline { font-size: 9px; letter-spacing: 1.8px; color: #a8b5cf; }
.hero-topline > span:first-child { display: flex; align-items: center; gap: 8px; }
.status-dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #92b0ff; box-shadow: 0 0 10px rgba(99, 144, 255, .7); flex-shrink: 0; }
.hero-coordinate { color: #6c7b97; }
.hero-layout { display: grid; grid-template-columns: 1.12fr 1fr; align-items: center; gap: 24px; padding: 80px 0 104px; min-height: 610px; }
.hero-copy { position: relative; z-index: 2; }
.eyebrow { font-size: 10px; font-weight: 500; letter-spacing: 1.8px; line-height: 1.6; }
.hero-eyebrow { display: flex; align-items: center; gap: 9px; color: #a6b8e0; font-size: 9px; letter-spacing: 1.7px; margin-bottom: 25px; }
.hero-eyebrow .icon { width: 11px; height: 11px; }
h1 { font-size: clamp(45px, 5.45vw, 89px); letter-spacing: -.065em; font-weight: 850; line-height: 1.04; }
h1 > span { display: block; white-space: nowrap; }
.hero-title-blue { color: #7197fb; position: relative; }
.title-star { display: inline-block; font-size: .34em; color: #a6bfff; vertical-align: top; margin: .15em 0 0 .1em; animation: star-turn 24s linear infinite; }
.hero-description { font-size: 15px; color: #a9b5cd; line-height: 1.8; margin-top: 28px; max-width: 420px; }
.hero-cta { display: flex; align-items: center; gap: 22px; margin-top: 33px; flex-wrap: wrap; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 57px; padding: 17px 22px; border-radius: 4px; font-size: 13px; font-weight: 600; transition: background .25s, box-shadow .25s, transform .25s; position: relative; }
.button-primary { background: var(--blue-strong); color: white; box-shadow: 0 3px 35px rgba(48, 103, 240, .17); }
.button .icon { width: 18px; height: 18px; }
.button .button-arrow { margin-left: 16px; width: 17px; height: 17px; transition: transform .25s; }
.button-primary:hover { background: #5185ff; box-shadow: 0 6px 36px rgba(48, 103, 240, .38); transform: translateY(-2px); }
.button:hover .button-arrow { transform: translate(2px, -2px); }
.text-link { display: inline-flex; align-items: center; gap: 18px; font-size: 12px; font-weight: 500; transition: color .2s; }
.text-link .icon { width: 17px; height: 17px; }
.text-link:hover { color: #a5bfff; }
.hero-explore { color: #ced7eb; font-size: 11px; gap: 12px; }
.download-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0; font-size: 10px; color: #91a1be; margin-top: 17px; line-height: 1.6; }
.download-meta > span + span::before { content: '·'; padding: 0 10px; color: #526585; }
.subscription-note { font-size: 10px; line-height: 1.6; color: #8b9bb6; margin-top: 6px; }
.hero-product { position: relative; margin: 0; width: 106%; transform: perspective(1300px) rotateY(-10deg) rotateX(4deg) rotateZ(-3deg); transform-style: preserve-3d; transition: transform .7s ease; will-change: transform; z-index: 1; }
.product-top { display: flex; align-items: center; gap: 7px; font-size: 8px; letter-spacing: 1.1px; color: #b5c7ed; padding: 10px 3px; }
.mini-pulsar { font-size: 17px; color: #a0bcff; }
.product-live { display: inline-flex; align-items: center; gap: 5px; margin-left: auto; font-size: 7px; color: #9badd0; }
.product-live i { width: 4px; height: 4px; background: #7fa8ff; border-radius: 50%; }
.product-window { border: 1px solid rgba(125, 167, 255, .5); border-radius: 8px; padding: 5px; background: #101b36; box-shadow: 0 40px 70px #020610b3, 0 0 50px #2759b721; overflow: hidden; }
.product-window img { width: 100%; height: auto; border-radius: 4px; }
.product-halo { position: absolute; inset: 10%; filter: blur(65px); background: #2759bd; opacity: .35; z-index: -1; border-radius: 50%; animation: halo-breathe 6s ease-in-out infinite alternate; }
.hero-product figcaption { display: flex; justify-content: space-between; font-size: 8px; letter-spacing: 1.5px; color: #7185ab; padding: 12px 2px; }
.product-tag { display: flex; align-items: center; gap: 10px; position: absolute; left: 8%; bottom: -18px; background: #111f3be8; border: 1px solid #4b639277; border-radius: 4px; backdrop-filter: blur(12px); padding: 12px 15px; color: #c1d3fb; box-shadow: 0 8px 36px #0004; font-size: 10px; transform: translateZ(25px) rotateZ(3deg); animation: product-tag-float 5s ease-in-out infinite; }
.product-tag .icon { width: 15px; height: 15px; margin-left: 10px; color: #94b4ff; }
.hero-orbit { position: absolute; width: 670px; height: 670px; right: -5%; top: 1%; border: 1px solid #4b77ce1a; border-radius: 50%; z-index: -1; transform: rotate(-25deg); }
.hero-orbit span { position: absolute; inset: 10%; border-radius: 50%; border: 1px solid #4b77ce14; }
.hero-orbit span:nth-child(2) { inset: 20%; }
.hero-orbit span:nth-child(3) { inset: 30%; }
.hero-orbit i { position: absolute; inset: 0; border-radius: 50%; animation: star-turn 25s linear infinite; }
.hero-orbit i::after { content: ''; width: 5px; height: 5px; position: absolute; left: 50%; top: -3px; background: #7ca4ff; border-radius: 50%; box-shadow: 0 0 15px #4887ff; }
.hero-bottom { border-top: 1px solid var(--line); padding-top: 21px; font-size: 8px; letter-spacing: 1.4px; color: #7789a9; }
.hero-bottom a { display: flex; align-items: center; gap: 24px; }
.hero-bottom a span { font-size: 16px; color: #b3c7ee; }
.section { max-width: 1550px; margin: 0 auto; padding: 100px 4.5%; }
.section-topline { margin-bottom: 35px; }
.section-topline .eyebrow { color: #8ea7db; }
.muted-label { font-size: 8px; letter-spacing: 1.4px; color: #788aa9; }
.section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 60px; margin-bottom: 46px; }
h2 { font-size: clamp(38px, 4.1vw, 65px); letter-spacing: -.055em; font-weight: 650; line-height: 1.12; }
.muted-text { color: #7d8ca8; }
.section-heading > p { font-size: 13px; color: #9aa9c3; max-width: 310px; line-height: 1.85; padding-bottom: 3px; }
.showcase-controls { display: grid; grid-template-columns: repeat(3,1fr); border-bottom: 1px solid var(--line); }
.showcase-tab { padding: 19px 20px 18px 0; text-align: left; display: flex; align-items: center; gap: 15px; background: transparent; font-size: 12px; border-bottom: 2px solid transparent; color: #8a9bb9; transition: color .2s, border-color .2s; }
.showcase-tab > span { font-size: 9px; color: #65799c; }
.showcase-tab .icon { width: 16px; height: 16px; margin-left: auto; opacity: 0; transform: translate(-4px,4px); transition: opacity .2s, transform .2s; }
.showcase-tab:hover { color: white; }
.showcase-tab.is-active { color: #e6eeff; border-color: #6997ff; }
.showcase-tab.is-active > span { color: #6997ff; }
.showcase-tab.is-active .icon { opacity: 1; transform: none; }
.showcase-stage { border: 1px solid var(--line); border-top: 0; background: radial-gradient(ellipse at 75% 50%, #102c524d, transparent 60%), #0b1424; overflow: hidden; border-radius: 0 0 6px 6px; }
.showcase-panel { display: grid; grid-template-columns: minmax(0,3fr) minmax(0,7fr); min-height: 440px; padding: 40px 30px 35px 40px; align-items: center; gap: 25px; animation: panel-enter .45s ease both; }
.showcase-caption { align-self: stretch; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 24px 0; }
.showcase-caption .eyebrow { font-size: 8px; letter-spacing: 1.5px; color: #90abe0; }
.showcase-caption h3 { font-size: clamp(26px, 2.6vw, 40px); line-height: 1.18; letter-spacing: -.045em; font-weight: 600; margin-top: 20px; }
.showcase-caption p { color: #91a3bf; font-size: 12px; line-height: 1.85; max-width: 240px; margin-top: 22px; }
.caption-footnote { font-size: 7px; letter-spacing: 1px; color: #7087ac; display: flex; align-items: center; gap: 12px; margin-top: auto; padding-top: 45px; }
.caption-footnote > span { color: #aac3f9; font-size: 18px; }
.features { padding-top: 25px; }
.feature-list { border-top: 1px solid var(--line); }
.feature-row { display: grid; grid-template-columns: 40px 52px minmax(220px, 1fr) minmax(250px, .9fr); gap: 22px; align-items: center; border-bottom: 1px solid var(--line); padding: 33px 8px 33px 0; transition: background .3s; }
.feature-row:hover { background: linear-gradient(90deg, transparent, #14254a66, transparent); }
.feature-number { font-size: 10px; color: #7487aa; }
.feature-symbol { width: 42px; height: 42px; color: #8bafff; display: grid; place-items: center; border: 1px solid #34476a; border-radius: 50%; transition: background .3s, transform .3s; }
.feature-row:hover .feature-symbol { background: #254c9d55; transform: rotate(-6deg); }
.feature-spark { font-size: 27px; }
.feature-row h3 { font-size: 20px; letter-spacing: -.5px; font-weight: 500; }
.feature-row p { font-size: 12px; color: #93a3bf; line-height: 1.9; max-width: 350px; }
.getting-started { border-top: 1px solid var(--line); padding-top: 85px; }
.getting-started .section-heading .text-link { padding-bottom: 10px; color: #9cb9fa; }
.steps { display: grid; grid-template-columns: repeat(3,1fr); gap: 50px; }
.step { position: relative; padding-top: 24px; border-top: 1px solid #344460; }
.step-top { display: flex; align-items: center; justify-content: space-between; }
.step-top > span { font-size: 57px; letter-spacing: -.06em; font-weight: 400; color: #607aa9; }
.step-top .icon { color: #8bafff; width: 26px; height: 26px; }
.step h3 { font-size: 21px; font-weight: 500; letter-spacing: -.5px; margin-top: 28px; }
.step p { font-size: 12px; line-height: 1.9; color: #93a3bf; margin-top: 14px; max-width: 300px; }
.step-rule { height: 1px; width: 0; background: #6e9bff; position: absolute; top: -1px; left: 0; transition: width 1.2s .2s; }
.is-visible .step-rule { width: 100%; }
.mobile-section { max-width: 1410px; margin: 12px 4.5% 0; padding: 80px 7.2%; position: relative; overflow: hidden; min-height: 550px; display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 30px; background: radial-gradient(ellipse at 75% 50%, #274c9e77, transparent 55%), #132348; border: 1px solid #304d8277; border-radius: 6px; isolation: isolate; }
@media (min-width:1550px) { .mobile-section { margin-left: auto; margin-right: auto; } }
.development-label { display: inline-flex; align-items: center; gap: 9px; border: 1px solid #5c7cab77; background: #5b80cb15; border-radius: 30px; padding: 8px 12px; font-size: 8px; letter-spacing: 1.5px; color: #bdcff3; }
.development-label .status-dot { animation: dot-breathe 2.5s ease-in-out infinite; }
.mobile-content { position: relative; z-index: 1; }
.mobile-content h2 { font-size: clamp(35px, 3.8vw, 58px); margin-top: 25px; }
.mobile-content h2 > span { color: #99b5ef; }
.mobile-content p { color: #a2b5d8; font-size: 13px; line-height: 1.9; margin-top: 22px; }
.mobile-content .text-link { margin-top: 27px; color: #e7efff; font-size: 11px; }
.mobile-orbit { position: absolute; right: -35%; top: 0; width: 85%; aspect-ratio: 1; border: 1px solid #6a95e533; border-radius: 50%; z-index: -1; }
.mobile-orbit::before, .mobile-orbit::after { content: ''; position: absolute; inset: 12%; border: 1px solid #6a95e526; border-radius: 50%; }
.mobile-orbit::after { inset: 25%; }
.phone-scene { position: relative; display: flex; align-items: center; justify-content: center; min-height: 400px; }
.phone { width: 207px; height: 405px; border: 2px solid #7093c8; padding: 5px; border-radius: 34px; background: #070d1d; box-shadow: 25px 25px 70px #03081599, inset 0 0 0 3px #1c2c47; position: relative; transform: rotate(11deg); animation: phone-float 7s ease-in-out infinite; }
.phone-screen { width: 100%; height: 100%; border-radius: 27px; overflow: hidden; background: radial-gradient(ellipse at 50% 47%, #21458caa, transparent 53%), linear-gradient(145deg,#091020,#142652); display: flex; flex-direction: column; align-items: center; text-align: center; }
.phone-notch { position: absolute; width: 64px; height: 17px; background: #050a16; border-radius: 12px; left: calc(50% - 32px); top: 10px; z-index: 1; }
.phone-caption { font-size: 7px; letter-spacing: 1.5px; color: #8099c6; margin-top: 49px; }
.phone-screen img { width: 79px; height: 79px; border-radius: 20px; margin-top: 43px; box-shadow: 0 0 45px #568df366; }
.phone-coming { font-size: 30px; font-weight: 650; line-height: 1.2; letter-spacing: -1px; margin-top: 26px; color: #e8f0ff; }
.phone-coming > span { display: block; font-size: 8px; line-height: 1.8; font-weight: 400; letter-spacing: 0; color: #9bafd4; margin-top: 7px; }
.phone-progress { width: 80px; height: 2px; background: #ffffff16; overflow: hidden; margin-top: 25px; }
.phone-progress span { display: block; height: 100%; width: 40%; background: #8cb2ff; animation: loading-sweep 3s ease-in-out infinite; }
.phone-concept { font-size: 6px; letter-spacing: 1.2px; color: #8299bf; margin-top: auto; margin-bottom: 24px; }
.phone-annotation { position: absolute; bottom: -28px; left: 50%; transform: translateX(-50%); color: #8ca9da; font-size: 6px; letter-spacing: 1.4px; white-space: nowrap; }
.phone-annotation > span { margin-left: 13px; font-size: 14px; }
.phone-orbit { width: 360px; height: 360px; border: 1px solid #6a95e526; border-radius: 50%; position: absolute; transform: rotateX(65deg) rotateZ(-22deg); box-shadow: 0 0 35px #2866d51a; }
.faq { display: grid; grid-template-columns: 1fr 1.2fr; gap: 100px; padding-top: 120px; padding-bottom: 120px; }
.faq-intro .eyebrow { color: #8ea7db; }
.faq-intro h2 { margin-top: 27px; }
.faq-intro > p { color: #93a3bf; font-size: 13px; line-height: 1.8; margin-top: 20px; }
.faq-intro .text-link { margin-top: 30px; color: #a8c0f8; }
.faq-list { border-top: 1px solid #35435f; }
.faq-list details { border-bottom: 1px solid var(--line); }
.faq-list summary { cursor: pointer; display: flex; align-items: center; gap: 19px; font-size: 13px; line-height: 1.6; padding: 23px 0; list-style: none; }
.faq-list summary::-webkit-details-marker { display: none; }
.faq-number { color: #6a80a5; font-size: 9px; flex-shrink: 0; }
.faq-plus { color: #8da9df; font-size: 22px; margin-left: auto; font-weight: 300; transition: transform .25s; }
.faq-list details[open] .faq-plus { transform: rotate(45deg); }
.faq-list details[open] summary { color: #b4ccff; }
.faq-answer { padding: 0 34px 25px; font-size: 12px; color: #93a3bf; line-height: 1.9; animation: panel-enter .3s ease both; }
.faq-answer a { display: inline-block; color: #aac4ff; margin-top: 10px; text-decoration: underline; text-underline-offset: 4px; }
.download-section { position: relative; overflow: hidden; border-top: 1px solid var(--line); background: #102145; padding: 82px 30px 88px; isolation: isolate; text-align: center; }
.download-bloom { position: absolute; width: 1000px; height: 700px; background: radial-gradient(ellipse, #356cdb66, transparent 67%); top: -250px; left: calc(50% - 500px); z-index: -1; animation: halo-breathe 8s ease-in-out infinite alternate; }
.download-inner { position: relative; z-index: 1; }
.download-inner > .eyebrow { color: #a3b9e5; font-size: 8px; }
.download-inner h2 { font-size: clamp(56px, 7.5vw, 112px); font-weight: 650; letter-spacing: -.06em; margin-top: 24px; line-height: 1.03; }
.accent-text { color: #8baeff; }
.button-light { color: #0b1731; background: #f3f6ff; margin-top: 32px; padding-left: 24px; padding-right: 24px; }
.button-light:hover { background: white; box-shadow: 0 0 40px #c5d5ff25; transform: translateY(-2px); }
.download-inner .download-meta { justify-content: center; color: #b2c3e2; margin-top: 18px; }
.release-link { color: #a8bce0; font-size: 10px; display: inline-block; margin-top: 12px; text-underline-offset: 4px; }
.release-link:hover { text-decoration: underline; }
.download-watermark { font-size: 25vw; line-height: .8; letter-spacing: -.07em; font-weight: 850; color: #8bb5ff05; position: absolute; left: 50%; bottom: -30px; transform: translateX(-50%); z-index: -1; pointer-events: none; }
.site-footer { max-width: 1550px; margin: auto; padding: 60px 4.5% 22px; }
.footer-top { display: grid; grid-template-columns: 1fr auto 50px; align-items: start; gap: 100px; padding-bottom: 55px; }
.footer-top p { font-size: 11px; color: #7d91b2; line-height: 1.8; margin-top: 15px; }
.footer-contact { display: flex; flex-direction: column; align-items: stretch; gap: 17px; }
.footer-contact > .eyebrow { color: #7890b7; font-size: 8px; margin-bottom: 2px; }
.footer-contact a { display: flex; align-items: center; gap: 10px; font-size: 11px; color: #bcc9e3; transition: color .2s; }
.footer-contact a:hover { color: white; }
.footer-contact .icon { width: 15px; height: 15px; }
.footer-contact .icon:last-child { margin-left: auto; }
.back-to-top { width: 46px; height: 46px; border: 1px solid #324260; color: #bdcdec; display: grid; place-items: center; border-radius: 50%; font-size: 22px; transition: background .2s; }
.back-to-top:hover { background: #172857; }
.footer-bottom { border-top: 1px solid var(--line); padding-top: 22px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 9px; color: #7c8ead; }
.footer-bottom > span:last-child { display: flex; align-items: center; gap: 10px; font-size: 7px; letter-spacing: 1.2px; }
.footer-star { font-size: 15px; color: #88a9ee; }
.toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); z-index: 100; padding: 16px 21px; background: #172b50f5; backdrop-filter: blur(12px); border: 1px solid #557ab47d; color: #d1e1ff; border-radius: 6px; box-shadow: 0 15px 60px #0006; display: flex; align-items: center; gap: 12px; font-size: 12px; width: max-content; max-width: calc(100% - 32px); animation: panel-enter .3s ease; }
.toast .icon { width: 18px; height: 18px; }
.js-motion .reveal { transition: opacity .75s ease, transform .75s cubic-bezier(.2,.65,.3,1); }
.js-motion .reveal:not(.is-visible) { opacity: 0; transform: translateY(27px); }
.showcase { border-top: 1px solid var(--line); --story-progress: 0; }
.showcase-stage { position: relative; isolation: isolate; }
.stage-glow { position: absolute; width: 48%; height: 85%; top: 8%; left: calc(14% + var(--story-progress) * 38%); background: radial-gradient(ellipse, #2f65d629, transparent 70%); filter: blur(20px); pointer-events: none; z-index: -1; }
.showcase-panel { --pair-progress: 0; position: relative; min-height: 505px; }
.showcase-caption { position: relative; z-index: 5; }
.showcase-gallery { position: relative; height: 430px; min-width: 0; perspective: 1300px; container-type: size; }
.gallery-shot { position: absolute; margin: 0; top: 50%; width: 76%; width: min(78cqw, calc((100cqh - 82px) * 1.5)); transform-style: preserve-3d; transition: transform .65s cubic-bezier(.2,.7,.2,1), filter .5s; will-change: transform; }
.shot-heading { display: flex; align-items: center; gap: 7px; color: #abc3f0; font-size: 7px; letter-spacing: 1px; line-height: 1.5; padding: 0 2px 8px; white-space: nowrap; }
.shot-heading .mini-pulsar { font-size: 15px; }
.shot-lights { display: inline-flex; margin-left: auto; gap: 4px; }
.shot-lights i { display: block; width: 3px; height: 3px; background: #7296d8; border-radius: 50%; }
.shot-lights i:nth-child(2) { opacity: .65; }
.shot-lights i:nth-child(3) { opacity: .35; }
.shot-window { padding: 4px; background: #10203b; border: 1px solid #6399ef88; border-radius: 7px; box-shadow: 0 25px 42px #02071499, 0 0 25px #2c65c51c; overflow: hidden; }
.shot-window img { display: block; width: 100%; height: auto; border-radius: 3px; }
.gallery-shot--single { left: 50%; width: 94%; width: min(94cqw, calc((100cqh - 42px) * 1.48)); transform: translate(-50%,-50%) rotateY(-7deg) rotateZ(-2deg); }
.showcase-gallery--pair .gallery-shot[data-shot='0'] { left: 1%; z-index: 3; transform: translate3d(calc(var(--pair-progress) * -7%),calc(-53% - var(--pair-progress) * 10%),0) rotateY(calc(-7deg - var(--pair-progress) * 7deg)) rotateZ(calc(-4deg - var(--pair-progress) * 2deg)) scale(calc(1 - var(--pair-progress) * .11)); filter: brightness(calc(1 - var(--pair-progress) * .18)); }
.showcase-gallery--pair .gallery-shot[data-shot='1'] { right: 0; z-index: 2; transform: translate3d(calc(5% - var(--pair-progress) * 5%),calc(-34% - var(--pair-progress) * 21%),0) rotateY(calc(10deg - var(--pair-progress) * 18deg)) rotateZ(calc(7deg - var(--pair-progress) * 11deg)) scale(calc(.86 + var(--pair-progress) * .14)); filter: brightness(calc(.76 + var(--pair-progress) * .24)); }
.is-second-focus .showcase-gallery--pair .gallery-shot[data-shot='0'] { z-index: 2; }
.is-second-focus .showcase-gallery--pair .gallery-shot[data-shot='1'] { z-index: 4; }
.shot-selectors { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 22px; }
.shot-selectors button { background: transparent; color: #9ab0d5; border: 1px solid #344b70; border-radius: 3px; padding: 8px 10px; font-size: 9px; transition: background .25s, border-color .25s, color .25s; }
.shot-selectors button.is-active { background: #264c9555; color: #dae7ff; border-color: #719ce2; }
.shot-selectors button:hover { color: white; border-color: #719ce2; }
.story-hint { display: flex; align-items: center; gap: 13px; }
.story-hint > span { color: #9ebaf0; font-size: 14px; }
.story-footer { display: none; align-items: center; gap: 17px; min-height: 38px; color: #8da4cb; font-size: 9px; }
.story-counter { color: #c0d4fc; font-variant-numeric: tabular-nums; }
.story-current { min-width: 145px; }
.story-track { height: 2px; flex: 1; background: #294064; overflow: hidden; }
.story-track i { display: block; width: 100%; height: 100%; background: #86aaff; transform: scaleX(var(--story-progress)); transform-origin: left; box-shadow: 0 0 12px #8ab2ff; }
.story-scroll-label { font-size: 7px; letter-spacing: 1.3px; margin-left: 8px; }
.showcase.is-scroll-story { height: calc(100svh + 280svh); padding-top: 0; padding-bottom: 0; }
.is-scroll-story .showcase-sticky { position: sticky; top: 16px; height: calc(100svh - 32px); max-height: 860px; display: flex; flex-direction: column; padding: 18px 0 8px; }
.is-scroll-story .section-topline { margin-bottom: 14px; flex-shrink: 0; }
.is-scroll-story .section-heading { margin-bottom: 20px; gap: 30px; flex-shrink: 0; }
.is-scroll-story .section-heading h2 { font-size: clamp(32px,3.2vw,49px); line-height: 1.08; }
.is-scroll-story .section-heading > p { font-size: 12px; max-width: 290px; }
.is-scroll-story .showcase-controls { flex-shrink: 0; }
.is-scroll-story .showcase-tab { padding-top: 15px; padding-bottom: 14px; font-size: 11px; }
.is-scroll-story .showcase-stage { flex: 1; min-height: 0; }
.is-scroll-story .showcase-panel { height: 100%; min-height: 0; padding: 24px 27px; gap: 22px; }
.is-scroll-story .showcase-caption { padding: 10px 0; }
.is-scroll-story .showcase-caption h3 { font-size: clamp(25px,2.5vw,38px); margin-top: 16px; }
.is-scroll-story .showcase-caption p { font-size: 12px; margin-top: 17px; }
.is-scroll-story .caption-footnote { padding-top: 22px; }
.is-scroll-story .showcase-gallery { height: 100%; min-height: 0; }
.is-scroll-story .gallery-shot { transition: filter .2s; }
.is-scroll-story .gallery-shot--single { transform: translate(-50%,calc(-50% - var(--scene-progress,0) * 2%)) rotateY(calc(-7deg + var(--scene-progress,0) * 6deg)) rotateZ(calc(-2deg + var(--scene-progress,0) * 2deg)); }
.is-scroll-story .story-footer { display: flex; flex-shrink: 0; }
.hero-copy { transform: translateY(calc(var(--hero-shift,0) * -24px)); }
@keyframes star-turn { to { transform: rotate(360deg); } }
@keyframes halo-breathe { from { opacity: .24; transform: scale(.95); } to { opacity: .5; transform: scale(1.08); } }
@keyframes product-tag-float { 0%,100% { transform: translateY(0) translateZ(25px) rotateZ(3deg); } 50% { transform: translateY(-8px) translateZ(25px) rotateZ(3deg); } }
@keyframes phone-float { 0%,100% { transform: translateY(0) rotate(11deg); } 50% { transform: translateY(-12px) rotate(8deg); } }
@keyframes dot-breathe { 50% { opacity: .4; } }
@keyframes loading-sweep { 0%,100% { transform: translateX(-110%); } 50% { transform: translateX(260%); } }
@keyframes panel-enter { from { opacity: 0; } to { opacity: 1; } }
@media (min-width: 1729px) { h1 { font-size: 89px; } }
@media (max-width: 1150px) {
  .hero-layout { grid-template-columns: 1.1fr 1fr; gap: 12px; padding: 72px 0 90px; min-height: 540px; }
